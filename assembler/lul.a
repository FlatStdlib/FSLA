@x86
i8 ptr;
i32 n;

struct Person {
	i8[] name;
	i8 age;
}

//            rdi       rsi        rdx
void write(i8 output, ptr string, i8 sz)
{
	asm("mov rax, 1");
	asm("syscall");
}

i8 entry()
{
	i8 n[] = "Hello World";

	write(1, n, 11);
	asm("mov rax, 60");
	asm("mov rdi, 0");
	asm("syscall");
}

