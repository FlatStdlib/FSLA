@x86_64
i8 ptr;
i32 n;
i8 my_name [];
i8 gay[3];
i8 age = 25;
i8 skid[] = "fag";
i8 nig[10] = "lol";
struct Person {
	i8 name[];
	i8 age;
}

//            rdi       rsi        rdx
void write (i8 output,     ptr    string, i8 size)
{
	asm("mov rax, 1");
	asm("syscall");
}

